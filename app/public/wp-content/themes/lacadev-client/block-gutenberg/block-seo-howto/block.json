{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lacadev/seo-howto-block",
  "title": "HowTo Schema Block",
  "category": "lacadev-blocks",
  "icon": "editor-ol",
  "textdomain": "laca",
  "keywords": ["howto", "instructions", "schema", "seo", "steps"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "How To Do Something"
    },
    "description": {
      "type": "string",
      "default": "Step by step instructions"
    },
    "totalTime": {
      "type": "string",
      "default": ""
    },
    "steps": {
      "type": "array",
      "default": [
        {
          "id": "step-1",
          "title": "Bước 1: Chuẩn bị",
          "content": "Nội dung bước 1.",
          "visible": true
        }
      ]
    }
  }
}
