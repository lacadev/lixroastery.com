{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/content-text-block",
    "title": "Content / Quote",
    "category": "lixroastery-blocks-site",
    "icon": "editor-quote",
    "editorScript": "block-block-content-text-editor",
    "style": "block-block-content-text",
    "textdomain": "laca",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "maxWidth": {
            "type": "number",
            "default": 50
        },
        "maxWidthTablet": {
            "type": "number",
            "default": 100
        },
        "maxWidthMobile": {
            "type": "number",
            "default": 100
        },
        "contentAlign": {
            "type": "string",
            "default": "center"
        },
        "contentAlignTablet": {
            "type": "string",
            "default": "center"
        },
        "contentAlignMobile": {
            "type": "string",
            "default": "center"
        },
        "variant": {
            "type": "string",
            "default": "normal"
        },
        "quoteFontFamily": {
            "type": "string",
            "default": ""
        },
        "quoteFontSize": {
            "type": "number",
            "default": 40
        },
        "quoteFontSizeTablet": {
            "type": "number",
            "default": 32
        },
        "quoteFontSizeMobile": {
            "type": "number",
            "default": 24
        },
        "textAlign": {
            "type": "string",
            "default": "left"
        },
        "content": {
            "type": "string",
            "translatable": true,
            "default": "Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat."
        },
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 800,
        "attributes": {
            "__isPreview": true
        }
    }
}
