{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/content-rows-block",
    "title": "Content Rows",
    "category": "lixroastery-blocks-site",
    "icon": "align-pull-left",
    "editorScript": "block-block-content-rows-editor",
    "style": "block-block-content-rows",
    "textdomain": "laca",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "mainTitle": {
            "type": "string",
            "translatable": true,
            "default": "TITLE"
        },
        "maxWidth": {
            "type": "number",
            "default": 50
        },
        "maxWidthTablet": {
            "type": "number",
            "default": 100
        },
        "maxWidthMobile": {
            "type": "number",
            "default": 100
        },
        "contentAlign": {
            "type": "string",
            "default": "center"
        },
        "contentAlignTablet": {
            "type": "string",
            "default": "center"
        },
        "contentAlignMobile": {
            "type": "string",
            "default": "center"
        },
        "rows": {
            "type": "array",
            "translatable": true,
            "default": [
                {
                    "subTitle": "Sub title 1",
                    "content": "<p>Nhập nội dung đoạn văn ở đây…</p>",
                    "asideType": "none",
                    "asideImages": [],
                    "quoteText": "",
                    "quoteAuthor": "",
                    "quoteSource": "",
                    "quoteAlign": "left",
                    "quoteFontFamily": "",
                    "quoteFontSize": 40,
                    "quoteFontSizeTablet": 32,
                    "quoteFontSizeMobile": 24
                }
            ]
        },
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 800,
        "attributes": {
            "__isPreview": true
        }
    }
}
