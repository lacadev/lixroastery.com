{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/tabs-block",
    "title": "Tabs",
    "category": "lixroastery-blocks-site",
    "icon": "index-card",
    "editorScript": "block-block-tabs-editor",
    "style": "block-block-tabs",
    "textdomain": "laca",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 800,
        "attributes": {
            "__isPreview": true
        }
    }
}
