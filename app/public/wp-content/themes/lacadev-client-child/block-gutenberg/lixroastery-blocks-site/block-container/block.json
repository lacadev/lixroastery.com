{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/container-block",
    "title": "Khung nội dung (Container)",
    "category": "lixroastery-blocks-site",
    "icon": "align-wide",
    "description": "Bọc các block mặc định (paragraph, heading, list...) vào 1 khung có thể tùy chỉnh kích thước tối đa và căn lề, để khớp độ rộng với các block riêng của theme.",
    "editorScript": "block-block-container-editor",
    "style": "block-block-container",
    "textdomain": "laca",
    "supports": {
        "html": false
    },
    "attributes": {
        "maxWidth": {
            "type": "number",
            "default": 50
        },
        "maxWidthTablet": {
            "type": "number",
            "default": 100
        },
        "maxWidthMobile": {
            "type": "number",
            "default": 100
        },
        "contentAlign": {
            "type": "string",
            "default": "center"
        },
        "contentAlignTablet": {
            "type": "string",
            "default": "center"
        },
        "contentAlignMobile": {
            "type": "string",
            "default": "center"
        },
        "headingFontSize": {
            "type": "number",
            "default": 34
        },
        "headingFontSizeTablet": {
            "type": "number",
            "default": 26
        },
        "headingFontSizeMobile": {
            "type": "number",
            "default": 18
        },
        "fontSize": {
            "type": "number",
            "default": 16
        },
        "fontSizeTablet": {
            "type": "number",
            "default": 15
        },
        "fontSizeMobile": {
            "type": "number",
            "default": 14
        },
        "lineHeight": {
            "type": "number",
            "default": 1.7
        },
        "lineHeightTablet": {
            "type": "number",
            "default": 1.7
        },
        "lineHeightMobile": {
            "type": "number",
            "default": 1.6
        },
        "blockSpacing": {
            "type": "number",
            "default": 20
        },
        "blockSpacingTablet": {
            "type": "number",
            "default": 16
        },
        "blockSpacingMobile": {
            "type": "number",
            "default": 14
        },
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 800,
        "attributes": {
            "__isPreview": true
        }
    }
}
