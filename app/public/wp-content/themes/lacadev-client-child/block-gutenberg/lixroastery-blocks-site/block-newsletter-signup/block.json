{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/newsletter-signup-block",
    "title": "Newsletter Signup",
    "category": "lixroastery-blocks-site",
    "icon": "email",
    "editorScript": "block-block-newsletter-signup-editor",
    "style": "block-block-newsletter-signup",
    "textdomain": "laca",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Connect with our mission - Join the sustainable circle"
        },
        "placeholder": {
            "type": "string",
            "default": "Your Email Address"
        },
        "buttonText": {
            "type": "string",
            "default": "Subscribe"
        },
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 800,
        "attributes": {
            "__isPreview": true
        }
    }
}
