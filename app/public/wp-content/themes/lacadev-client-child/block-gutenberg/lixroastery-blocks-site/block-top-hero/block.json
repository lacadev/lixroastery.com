{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/top-hero-block",
    "title": "Top Hero",
    "category": "lixroastery-blocks-site",
    "icon": "cover-image",
    "editorScript": "block-block-top-hero-editor",
    "style": "block-block-top-hero",
    "textdomain": "laca",
    "supports": {
        "html": false,
        "align": ["full"]
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        },
        "heroImageId": {
            "type": "number",
            "default": 0
        },
        "heroImageUrl": {
            "type": "string",
            "default": ""
        },
        "headline": {
            "type": "string",
            "translatable": true,
            "default": "SUSTAINABILITY IS NOT A CHOICE<br>IT'S OUR FUNDAMENTAL RESPONSIBILITY"
        },
        "description": {
            "type": "string",
            "translatable": true,
            "default": ""
        },
        "overlayColor": {
            "type": "string",
            "default": "#0f1f13"
        },
        "overlayOpacity": {
            "type": "number",
            "default": 45
        },
        "heightMode": {
            "type": "string",
            "default": "custom"
        },
        "minHeight": {
            "type": "number",
            "default": 560
        },
        "fullBleed": {
            "type": "boolean",
            "default": false
        },
        "textWidth": {
            "type": "number"
        },
        "textWidthTablet": {
            "type": "number"
        },
        "textWidthMobile": {
            "type": "number"
        },
        "contentVertical": {
            "type": "string",
            "default": "bottom"
        },
        "contentVerticalTablet": {
            "type": "string",
            "default": "center"
        },
        "contentVerticalMobile": {
            "type": "string",
            "default": "center"
        },
        "contentHorizontal": {
            "type": "string",
            "default": "center"
        },
        "contentHorizontalTablet": {
            "type": "string",
            "default": "center"
        },
        "contentHorizontalMobile": {
            "type": "string",
            "default": "center"
        },
        "offsetY": {
            "type": "number",
            "default": 20
        },
        "offsetYTablet": {
            "type": "number",
            "default": 10
        },
        "offsetYMobile": {
            "type": "number",
            "default": 10
        },
        "offsetX": {
            "type": "number",
            "default": 5
        },
        "offsetXTablet": {
            "type": "number",
            "default": 5
        },
        "offsetXMobile": {
            "type": "number",
            "default": 5
        },
        "textAlign": {
            "type": "string",
            "default": "center"
        },
        "textAlignTablet": {
            "type": "string",
            "default": "center"
        },
        "textAlignMobile": {
            "type": "string",
            "default": "center"
        },
        "overlayType": {
            "type": "string",
            "default": "solid"
        },
        "overlayColor2": {
            "type": "string",
            "default": "#000000"
        },
        "overlayOpacity2": {
            "type": "number",
            "default": 0
        },
        "overlayDirection": {
            "type": "string",
            "default": "180"
        },
        "parallax": {
            "type": "boolean",
            "default": false
        },
        "parallaxStrength": {
            "type": "number",
            "default": 30
        },
        "zoomIn": {
            "type": "boolean",
            "default": false
        },
        "textReveal": {
            "type": "boolean",
            "default": false
        },
        "scrollDarken": {
            "type": "boolean",
            "default": false
        },
        "scrollDarkenMax": {
            "type": "number",
            "default": 60
        },
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "viewportWidth": 800,
        "attributes": {
            "__isPreview": true
        }
    }
}
