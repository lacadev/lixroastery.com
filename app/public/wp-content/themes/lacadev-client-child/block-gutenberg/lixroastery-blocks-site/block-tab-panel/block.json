{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lacadev/tab-panel-block",
    "title": "Tab Panel",
    "category": "lixroastery-blocks-site",
    "icon": "index-card",
    "parent": ["lacadev/tabs-block"],
    "editorScript": "block-block-tab-panel-editor",
    "style": "block-block-tab-panel",
    "textdomain": "laca",
    "supports": {
        "html": false,
        "reusable": false
    },
    "attributes": {
        "tabTitle": {
            "type": "string",
            "default": "Tab"
        },
        "__isPreview": {
            "type": "boolean",
            "default": false
        }
    },
    "example": {
        "attributes": {
            "__isPreview": true
        }
    }
}
